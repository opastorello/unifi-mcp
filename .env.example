# ── Ambiente ────────────────────────────────────────────────
ENV=production
# ENV=development   # abre /docs e dispensa API_TOKEN

# ── Auth (secret — NÃO vai no config.json) ─────────────────
# OBRIGATÓRIO em produção. Protege REST + MCP (/mcp).
# Gere um: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ── Config path ────────────────────────────────────────────
# Devices, server, upstream settings e logging vivem aqui.
# Default: config/config.json (relativo ao cwd do servidor)
CONFIG_PATH=config/config.json

# ── Rate limit (formato: N/second | N/minute | N/hour) ─────
RATE_LIMIT_DEFAULT=60/minute

# ── Proxy trust (quantos proxies reversos estão na frente) ────
# 0 = conexão direta (ignora X-Forwarded-For para rate limit)
# 1 = um proxy (Coolify/Caddy) — usa último IP no X-Forwarded-For
# 2 = dois proxies (CDN → Caddy) — usa penúltimo IP
TRUSTED_PROXY_COUNT=0

# ── Porta (override Docker — precedência sobre config.json) ─
# PORT=8012
